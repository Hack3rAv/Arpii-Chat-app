{
  "name": "system-utility-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers, Durable Objects, D1, and R2 backend for System Utility Private Messenger",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply arpii --local",
    "db:migrate:remote": "wrangler d1 migrations apply arpii --remote",
    "provision": "node scripts/provision-accounts.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^1.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1",
    "wrangler": "^4.13.0"
  }
}
